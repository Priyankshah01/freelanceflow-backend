# Copy this file to .env and fill in the values. Never commit .env.

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/freelanceflow

# Long random string used to sign login tokens
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRE=30d

# Your deployed frontend, so the API accepts its requests (CORS).
# *.vercel.app and localhost are already allowed.
FRONTEND_URL=https://your-frontend.vercel.app
# Optional extra origins, comma-separated
ALLOWED_ORIGINS=

PORT=5000
NODE_ENV=development
